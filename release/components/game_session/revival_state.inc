#ifndef NANAIMO_GAME_SESSION_REVIVAL_STATE_INC
#define NANAIMO_GAME_SESSION_REVIVAL_STATE_INC
#define GAME_SESSION_REVIVAL_MAX 99u
/* profile keys may contain p_ plus 16 hex-encoded name bytes and NUL. */
static unsigned g_game_session_revival_uses=0u;static int g_game_session_revival_loaded=0;static char g_game_session_revival_account[48];
static int game_session_revive_streq(const char*a,const char*b){while(*a&&*b&&*a==*b){a++;b++;}return *a==*b;}
static void game_session_revive_copy(char*d,unsigned cap,const char*s){unsigned i=0;if(!cap)return;while(s[i]&&i+1u<cap){d[i]=s[i];i++;}d[i]=0;}
static void game_session_revival_path(char*out,const char*suffix){char a[48];unsigned n=0u,i=0u;const char*p="nanaimo_revival_state_v1_";card_safe_account(a);while(*p)out[n++]=*p++;while(a[i])out[n++]=a[i++];while(*suffix)out[n++]=*suffix++;out[n]=0;}
static int game_session_revival_save(void){char path[128],tmp[128],bak[128];void*f;game_session_revival_path(path,".dat");game_session_revival_path(tmp,".new");game_session_revival_path(bak,".bak");f=fopen(tmp,"w");if(!f)return 0;fprintf(f,"version=1\nuses=%u\n",g_game_session_revival_uses);if(fclose(f)!=0)return 0;remove(bak);rename(path,bak);if(rename(tmp,path)!=0){rename(bak,path);return 0;}remove(bak);return 1;}
static void game_session_revival_load(void){char a[48],path[128],bak[128],line[128];void*f=0;unsigned v;card_safe_account(a);if(g_game_session_revival_loaded&&game_session_revive_streq(a,g_game_session_revival_account))return;g_game_session_revival_uses=0u;game_session_revival_path(path,".dat");game_session_revival_path(bak,".bak");f=fopen(path,"r");if(!f)f=fopen(bak,"r");if(f){while(fgets(line,sizeof(line),f))if(sscanf(line,"uses=%u",&v)==1&&v<=GAME_SESSION_REVIVAL_MAX)g_game_session_revival_uses=v;fclose(f);}game_session_revive_copy(g_game_session_revival_account,sizeof(g_game_session_revival_account),a);g_game_session_revival_loaded=1;printf("  [REVIVE_DB] load account=%s uses=%u source=%s\n",a,g_game_session_revival_uses,f?"file":"default0");fflush(0);}
static unsigned game_session_revival_count(void){game_session_revival_load();return g_game_session_revival_uses;}
static unsigned game_session_revival_bundle_units(unsigned code){switch(code){case 48000001u:return 5u;case 48000002u:return 10u;case 48000003u:return 30u;case 48000004u:return 1u;case 48000005u:return 5u;case 48000006u:return 11u;case 48000007u:return 32u;default:return 0u;}}
static int game_session_revival_set(unsigned v){unsigned old;game_session_revival_load();if(v>GAME_SESSION_REVIVAL_MAX)return 0;old=g_game_session_revival_uses;g_game_session_revival_uses=v;if(game_session_revival_save())return 1;g_game_session_revival_uses=old;return 0;}
static int game_session_revival_reserve_bundle(unsigned code,unsigned*old_out,unsigned*new_out){unsigned old,units,n;game_session_revival_load();units=game_session_revival_bundle_units(code);old=g_game_session_revival_uses;if(!units||old>GAME_SESSION_REVIVAL_MAX-units)return 0;n=old+units;if(!game_session_revival_set(n))return 0;if(old_out)*old_out=old;if(new_out)*new_out=n;return 1;}
static int game_session_revival_rollback(unsigned old){return game_session_revival_set(old);}
static int game_session_revival_consume_retry(unsigned*before,unsigned*after){unsigned old;game_session_revival_load();old=g_game_session_revival_uses;if(!old)return 0;if(!game_session_revival_set(old-1u))return 0;if(before)*before=old;if(after)*after=old-1u;return 1;}
#endif
