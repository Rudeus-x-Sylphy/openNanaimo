static unsigned long long card_monster_name_hash(const char*name){unsigned long long hash=14695981039346656037ULL;if(!name)return 0ULL;while(*name){hash^=card_monster_name_lower((unsigned char)*name++);hash*=1099511628211ULL;}return hash;}
