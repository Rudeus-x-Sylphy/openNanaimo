#ifndef NANAIMO_SHOP_CATALOGS_SHOP_PROTOCOL_INC
#define NANAIMO_SHOP_CATALOGS_SHOP_PROTOCOL_INC
static void send_c470_misc_purchase(SOCKET c,const unsigned char*req,int success){char p[4096];unsigned code=(unsigned)req[0x0C]|((unsigned)req[0x0D]<<8)|((unsigned)req[0x0E]<<16)|((unsigned)req[0x0F]<<24);mkpkt(p,0xC470,0x68,1);p[8]=(char)(success?10u:40u);p[9]=success?req[8]:0;p[0x0A]=(char)(success?1:0);p[0x0B]=(char)(success?1:0);stable_put32(p,0x0C,code);stable_resource_put16(p,0x12,success?1u:0u);stable_resource_put64(p,0x58,g_profile_nana_cash);stable_resource_put64(p,0x60,g_profile_coin_hans);sendbuf(c,p,0x68);printf("  S0xC470 SHOP_PURCHASE success=%d selector=%u code=%u nana=%u:%u coin=%u:%u len=104 t=%lds\n",success,(unsigned char)p[8],code,(unsigned)(g_profile_nana_cash>>32),(unsigned)g_profile_nana_cash,(unsigned)(g_profile_coin_hans>>32),(unsigned)g_profile_coin_hans,sec());fflush(0);}
static void send_c432_pet_purchase(SOCKET c,const unsigned char*req,int success){char p[4096];unsigned code=(unsigned)req[0x0C]|((unsigned)req[0x0D]<<8)|((unsigned)req[0x0E]<<16)|((unsigned)req[0x0F]<<24);mkpkt(p,0xC432,0x68,1);p[8]=(char)(success?10u:40u);p[9]=success?req[8]:0;p[0x0A]=(char)(success?1:0);p[0x0B]=(char)(success?1:0);stable_put32(p,0x0C,code);stable_resource_put16(p,0x12,success?1u:0u);stable_resource_put64(p,0x58,g_profile_nana_cash);stable_resource_put64(p,0x60,g_profile_coin_hans);sendbuf(c,p,0x68);printf("  S0xC432 SHOP_PURCHASE success=%d selector=%u code=%u nana=%u:%u coin=%u:%u len=104 t=%lds\n",success,(unsigned char)p[8],code,(unsigned)(g_profile_nana_cash>>32),(unsigned)g_profile_nana_cash,(unsigned)(g_profile_coin_hans>>32),(unsigned)g_profile_coin_hans,sec());fflush(0);}
static void send_c3d2_face_coupon_result(SOCKET c,int success,const unsigned requested[9]){char p[4096];unsigned i;mkpkt(p,0xC3D2,0x34,1);stable_resource_put16(p,8,success?1000u:0u);if(success&&requested)for(i=0u;i<9u;i++)stable_put32(p,0x10+(int)(i*4u),requested[i]);sendbuf(c,p,0x34);printf("  S0xC3D2 FACE_COUPON success=%d face=%u len=52 t=%lds\n",success,(success&&requested)?requested[1]:0u,sec());fflush(0);}
#endif
