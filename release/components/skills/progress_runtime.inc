static void skill_progress_load(void){void*f;char line[128];unsigned i,v;if(g_skill_progress_loaded)return;g_skill_progress_loaded=1u;skill_progress_defaults();f=fopen("skill_progress_state_v1.dat","r");if(!f)return;while(fgets(line,sizeof(line),f)){if(sscanf(line,"sp_meat=%u",&v)==1){if(v<=65535u)g_skill_progress_sp_meat=v;continue;}if(sscanf(line,"sp=%u",&v)==1){if(v<=65535u)g_skill_progress_sp=v;continue;}if(sscanf(line,"slot0=%u",&v)==1){g_skill_progress_slots[0]=v;continue;}if(sscanf(line,"slot1=%u",&v)==1){g_skill_progress_slots[1]=v;continue;}for(i=0;i<SKILL_PROGRESS_COUNT;i++){char key[16];/* TCC-safe explicit scan below. */if(sscanf(line,"grade%u=%u",&v,&v)==2)break;}if(sscanf(line,"grade0=%u",&v)==1)g_skill_progress_grade[0]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade1=%u",&v)==1)g_skill_progress_grade[1]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade2=%u",&v)==1)g_skill_progress_grade[2]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade3=%u",&v)==1)g_skill_progress_grade[3]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade4=%u",&v)==1)g_skill_progress_grade[4]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade5=%u",&v)==1)g_skill_progress_grade[5]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade6=%u",&v)==1)g_skill_progress_grade[6]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade7=%u",&v)==1)g_skill_progress_grade[7]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade8=%u",&v)==1)g_skill_progress_grade[8]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade9=%u",&v)==1)g_skill_progress_grade[9]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade10=%u",&v)==1)g_skill_progress_grade[10]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade11=%u",&v)==1)g_skill_progress_grade[11]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade12=%u",&v)==1)g_skill_progress_grade[12]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade13=%u",&v)==1)g_skill_progress_grade[13]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade14=%u",&v)==1)g_skill_progress_grade[14]=(unsigned char)(v>5u?5u:v);else if(sscanf(line,"grade15=%u",&v)==1)g_skill_progress_grade[15]=(unsigned char)(v>5u?5u:v);}(void)i;fclose(f);}
static int skill_progress_save(void){void*f;unsigned i;f=fopen("skill_progress_state_v1.new","w");if(!f)return 0;fprintf(f,"version=1\nsp=%u\nsp_meat=%u\nslot0=%u\nslot1=%u\n",g_skill_progress_sp,g_skill_progress_sp_meat,g_skill_progress_slots[0],g_skill_progress_slots[1]);for(i=0;i<SKILL_PROGRESS_COUNT;i++)fprintf(f,"grade%u=%u\n",i,(unsigned)g_skill_progress_grade[i]);if(fclose(f)!=0)return 0;remove("skill_progress_state_v1.bak");rename("skill_progress_state_v1.dat","skill_progress_state_v1.bak");if(rename("skill_progress_state_v1.new","skill_progress_state_v1.dat")!=0){rename("skill_progress_state_v1.bak","skill_progress_state_v1.dat");return 0;}remove("skill_progress_state_v1.bak");return 1;}
