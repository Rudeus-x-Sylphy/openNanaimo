#ifndef NANAIMO_PROGRESSION_PROGRESSION_RUNTIME_INC
#define NANAIMO_PROGRESSION_PROGRESSION_RUNTIME_INC
#define PROGRESSION_MAX_LEVEL 99u
#define PROGRESSION_CLEAR_EXP 100u
#define PROGRESSION_MAX_DUNGEON_GRADE 42u
#define DUNGEON_PROGRESSION_GRADE_POLICY_SHIPPED_STAGE_FLOOR 2u
struct progression_progression_state { unsigned level,exp_total,lower,next; };
struct progression_progression_result { unsigned old_level,new_level,old_exp,new_exp,added,level_up,lower,next,saved; };
struct progression_dungeon_tuple { unsigned hd,episode,dungeon,difficulty,stage_index; };
struct progression_dungeon_grade_state { unsigned grade,frontier_valid;struct progression_dungeon_tuple frontier; };
struct progression_dungeon_grade_result { unsigned old_grade,new_grade,frontier_advanced,grade_up,saved,tuple_valid;struct progression_dungeon_tuple cleared,old_frontier,new_frontier; };
static unsigned g_progression_profile_exp_total=0u;
static unsigned g_progression_profile_dungeon_grade=0u;
static unsigned progression_progression_threshold(unsigned level){unsigned n;if(level<=1u)return 0u;if(level>PROGRESSION_MAX_LEVEL)level=PROGRESSION_MAX_LEVEL;n=level-1u;return 50u*n*(n+1u);}
static unsigned progression_progression_level_for_exp(unsigned exp){unsigned level=1u;while(level<PROGRESSION_MAX_LEVEL&&exp>=progression_progression_threshold(level+1u))level++;return level;}
static void progression_progression_key_from_name(char*out,const unsigned char*name,unsigned len){static const char h[]="0123456789ABCDEF";unsigned i;if(len>16u)len=16u;if(!len){const char*d="default";while(*d)*out++=*d++;*out=0;return;}for(i=0;i<len;i++){unsigned v=name[i];out[i*2]=h[v>>4];out[i*2+1]=h[v&15u];}out[len*2]=0;}
static void progression_profile_state_path(char*out,const char*prefix,const unsigned char*name,unsigned len,const char*suffix){char key[40];unsigned n=0u,i=0u;progression_progression_key_from_name(key,name,len);while(*prefix)out[n++]=*prefix++;while(key[i])out[n++]=key[i++];while(*suffix)out[n++]=*suffix++;out[n]=0;}
static void progression_progression_path(char*out,const unsigned char*name,unsigned len,const char*suffix){progression_profile_state_path(out,"level_progress_state_v1_",name,len,suffix);}
static int progression_progression_parse_path(const char*path,struct progression_progression_state*out){void*f=fopen(path,"r");char line[128];unsigned level=0u,exp=0u,have_level=0u,have_exp=0u;if(!f)return 0;while(fgets(line,sizeof(line),f)){unsigned v;if(sscanf(line,"level=%u",&v)==1){level=v;have_level=1u;}else if(sscanf(line,"exp_total=%u",&v)==1){exp=v;have_exp=1u;}}fclose(f);if(!have_level||!have_exp||level<1u||level>PROGRESSION_MAX_LEVEL||progression_progression_level_for_exp(exp)!=level)return 0;out->level=level;out->exp_total=exp;out->lower=progression_progression_threshold(level);out->next=progression_progression_threshold(level<PROGRESSION_MAX_LEVEL?level+1u:PROGRESSION_MAX_LEVEL)+((level==PROGRESSION_MAX_LEVEL)?level*100u:0u);return 1;}
static int progression_progression_save_name(const unsigned char*name,unsigned len,const struct progression_progression_state*s){char path[128],tmp[128],bak[128];void*f;progression_progression_path(path,name,len,".dat");progression_progression_path(tmp,name,len,".new");progression_progression_path(bak,name,len,".bak");f=fopen(tmp,"w");if(!f)return 0;fprintf(f,"version=1\nlevel=%u\nexp_total=%u\n",s->level,s->exp_total);if(fclose(f)!=0)return 0;remove(bak);rename(path,bak);if(rename(tmp,path)!=0){rename(bak,path);return 0;}remove(bak);return 1;}
static int progression_progression_read_name(const unsigned char*name,unsigned len,unsigned seed_level,struct progression_progression_state*out,int create){char path[128],bak[128];if(seed_level<1u||seed_level>PROGRESSION_MAX_LEVEL)seed_level=1u;progression_progression_path(path,name,len,".dat");progression_progression_path(bak,name,len,".bak");if(progression_progression_parse_path(path,out))return 1;if(progression_progression_parse_path(bak,out)){if(create)progression_progression_save_name(name,len,out);return 1;}out->level=seed_level;out->exp_total=progression_progression_threshold(seed_level);out->lower=progression_progression_threshold(seed_level);out->next=progression_progression_threshold(seed_level<PROGRESSION_MAX_LEVEL?seed_level+1u:PROGRESSION_MAX_LEVEL)+((seed_level==PROGRESSION_MAX_LEVEL)?seed_level*100u:0u);if(create)progression_progression_save_name(name,len,out);return 0;}
static void progression_dungeon_grade_path(char*out,const unsigned char*name,unsigned len,const char*suffix){progression_profile_state_path(out,"dungeon_grade_state_v1_",name,len,suffix);}
static int progression_dungeon_tuple_valid(const struct progression_dungeon_tuple*t){return t&&t->hd<=255u&&t->episode<=255u&&t->dungeon<=255u&&t->difficulty<=2u&&t->stage_index<=2u;}
static int progression_dungeon_tuple_compare(const struct progression_dungeon_tuple*a,const struct progression_dungeon_tuple*b){if(a->hd!=b->hd)return a->hd>b->hd?1:-1;if(a->episode!=b->episode)return a->episode>b->episode?1:-1;if(a->dungeon!=b->dungeon)return a->dungeon>b->dungeon?1:-1;if(a->difficulty!=b->difficulty)return a->difficulty>b->difficulty?1:-1;if(a->stage_index!=b->stage_index)return a->stage_index>b->stage_index?1:-1;return 0;}
/* Canonical title policy.  A title is awarded only by stage1
   Super-BOSS completion; ordinary stage0 never awards.  Villages1..4 keep the
   selected wire episode0..15 with dungeon2 and map directly to grades1..16.
   Lumineos keeps wire episode100/dungeon0..6 (resource ep16..22 aliases are
   lookup-only) and maps to grades17..23.  Difficulty is not part of the award. */
static int dungeon_progression_dungeon_grade_shipped_floor(const struct progression_dungeon_tuple*wire,struct progression_dungeon_tuple*canonical,unsigned*target){if(!wire||!canonical||!target)return 0;*canonical=*wire;*target=0u;if(wire->hd!=0u||wire->stage_index!=1u)return 0;if(wire->episode<=15u&&wire->dungeon==2u){*target=wire->episode+1u;return 1;}if(wire->episode==100u&&wire->dungeon<=6u){*target=17u+wire->dungeon;return 1;}return 0;}
/* The retired bug wrote grade23 from ep15/dg2 regardless of stage and then
   canonicalized stage1 to stage0.  A stage1 legacy row has a provable grade16;
   a stage0 row has no title proof in this file and is reset to bounded grade0
   until the managed history ledger imports the authoritative recomputation. */
static int dungeon_progression_dungeon_grade_is_retired_r7_bug(const struct progression_dungeon_grade_state*s){return s&&s->frontier_valid&&s->grade==23u&&s->frontier.hd==0u&&s->frontier.episode==15u&&s->frontier.dungeon==2u&&s->frontier.stage_index<=1u;}
static int dungeon_progression_dungeon_grade_normalize_state(struct progression_dungeon_grade_state*s){struct progression_dungeon_tuple canonical;unsigned target=0u,changed=0u;if(!s||!s->frontier_valid)return 0;if(dungeon_progression_dungeon_grade_is_retired_r7_bug(s)){s->grade=s->frontier.stage_index==1u?16u:0u;changed=1u;}if(dungeon_progression_dungeon_grade_shipped_floor(&s->frontier,&canonical,&target)){if(progression_dungeon_tuple_compare(&canonical,&s->frontier)!=0){s->frontier=canonical;changed=1u;}if(s->grade<target){s->grade=target;changed=1u;}}return (int)changed;}
static int progression_dungeon_grade_parse_path(const char*path,struct progression_dungeon_grade_state*out){void*f=fopen(path,"r");char line[160];unsigned version=0u,grade=0u,valid=0u,hd=0u,ep=0u,dg=0u,diff=0u,st=0u;unsigned hv=0u,hg=0u,hf=0u,hh=0u,he=0u,hdg=0u,hdi=0u,hs=0u;if(!f)return 0;while(fgets(line,sizeof(line),f)){unsigned v;if(sscanf(line,"version=%u",&v)==1){version=v;hv=1u;}else if(sscanf(line,"grade=%u",&v)==1){grade=v;hg=1u;}else if(sscanf(line,"frontier_valid=%u",&v)==1){valid=v;hf=1u;}else if(sscanf(line,"frontier_hd=%u",&v)==1){hd=v;hh=1u;}else if(sscanf(line,"frontier_episode=%u",&v)==1){ep=v;he=1u;}else if(sscanf(line,"frontier_dungeon=%u",&v)==1){dg=v;hdg=1u;}else if(sscanf(line,"frontier_difficulty=%u",&v)==1){diff=v;hdi=1u;}else if(sscanf(line,"frontier_stage=%u",&v)==1){st=v;hs=1u;}}fclose(f);if(!hv||version!=1u||!hg||grade>PROGRESSION_MAX_DUNGEON_GRADE||!hf||valid>1u)return 0;memset(out,0,sizeof(*out));out->grade=grade;out->frontier_valid=valid;if(valid){if(!hh||!he||!hdg||!hdi||!hs)return 0;out->frontier.hd=hd;out->frontier.episode=ep;out->frontier.dungeon=dg;out->frontier.difficulty=diff;out->frontier.stage_index=st;if(!progression_dungeon_tuple_valid(&out->frontier))return 0;}return 1;}
static int progression_dungeon_grade_save_name(const unsigned char*name,unsigned len,const struct progression_dungeon_grade_state*s){char path[128],tmp[128],bak[128];void*f;progression_dungeon_grade_path(path,name,len,".dat");progression_dungeon_grade_path(tmp,name,len,".new");progression_dungeon_grade_path(bak,name,len,".bak");f=fopen(tmp,"w");if(!f)return 0;fprintf(f,"version=1\ngrade=%u\nfrontier_valid=%u\nfrontier_hd=%u\nfrontier_episode=%u\nfrontier_dungeon=%u\nfrontier_difficulty=%u\nfrontier_stage=%u\n",s->grade,s->frontier_valid,s->frontier.hd,s->frontier.episode,s->frontier.dungeon,s->frontier.difficulty,s->frontier.stage_index);if(fclose(f)!=0)return 0;remove(bak);rename(path,bak);if(rename(tmp,path)!=0){rename(bak,path);return 0;}remove(bak);return 1;}
static int progression_dungeon_grade_read_name(const unsigned char*name,unsigned len,struct progression_dungeon_grade_state*out,int create){char path[128],bak[128];int changed=0;progression_dungeon_grade_path(path,name,len,".dat");progression_dungeon_grade_path(bak,name,len,".bak");if(progression_dungeon_grade_parse_path(path,out)){changed=dungeon_progression_dungeon_grade_normalize_state(out);if(create&&changed)progression_dungeon_grade_save_name(name,len,out);return 1;}if(progression_dungeon_grade_parse_path(bak,out)){dungeon_progression_dungeon_grade_normalize_state(out);if(create)progression_dungeon_grade_save_name(name,len,out);return 1;}memset(out,0,sizeof(*out));if(create)progression_dungeon_grade_save_name(name,len,out);return 0;}
static void progression_progression_load_current_seed(unsigned seed_level){struct progression_progression_state p;struct progression_dungeon_grade_state d;progression_progression_read_name(g_stable_name,g_stable_name_len,seed_level,&p,1);progression_dungeon_grade_read_name(g_stable_name,g_stable_name_len,&d,1);g_stable_level=p.level;g_progression_profile_exp_total=p.exp_total;g_progression_profile_dungeon_grade=d.grade;}
static void progression_progression_snapshot_name(const unsigned char*name,unsigned len,unsigned seed_level,struct progression_progression_state*out){progression_progression_read_name(name,len,seed_level,out,0);}
static void progression_dungeon_grade_snapshot_name(const unsigned char*name,unsigned len,struct progression_dungeon_grade_state*out){progression_dungeon_grade_read_name(name,len,out,0);}
static unsigned progression_dungeon_grade_current(void){return g_progression_profile_dungeon_grade<=PROGRESSION_MAX_DUNGEON_GRADE?g_progression_profile_dungeon_grade:0u;}
static int progression_progression_award_current(unsigned allow,unsigned amount,struct progression_progression_result*r){struct progression_progression_state s,n;memset(r,0,sizeof(*r));progression_progression_read_name(g_stable_name,g_stable_name_len,STABLE_LEVEL,&s,1);r->old_level=s.level;r->old_exp=s.exp_total;n=s;if(allow&&s.level<PROGRESSION_MAX_LEVEL){if(0xFFFFFFFFu-s.exp_total<amount)amount=0xFFFFFFFFu-s.exp_total;n.exp_total=s.exp_total+amount;n.level=progression_progression_level_for_exp(n.exp_total);if(n.level>PROGRESSION_MAX_LEVEL)n.level=PROGRESSION_MAX_LEVEL;r->added=amount;r->level_up=n.level>s.level?1u:0u;}n.lower=progression_progression_threshold(n.level);n.next=progression_progression_threshold(n.level<PROGRESSION_MAX_LEVEL?n.level+1u:PROGRESSION_MAX_LEVEL)+((n.level==PROGRESSION_MAX_LEVEL)?n.level*100u:0u);r->new_level=n.level;r->new_exp=n.exp_total;r->lower=n.lower;r->next=n.next;if(r->added){if(!progression_progression_save_name(g_stable_name,g_stable_name_len,&n)){r->added=0u;r->level_up=0u;r->new_level=s.level;r->new_exp=s.exp_total;r->lower=s.lower;r->next=s.next;return 0;}r->saved=1u;}g_stable_level=r->new_level;g_progression_profile_exp_total=r->new_exp;return 1;}
static int progression_dungeon_grade_award_current(unsigned allow,const struct progression_dungeon_tuple*cleared,struct progression_dungeon_grade_result*r){struct progression_dungeon_grade_state s,n;struct progression_dungeon_tuple canonical;unsigned target=0u,mapped=0u,changed=0u;int harder=0;memset(r,0,sizeof(*r));progression_dungeon_grade_read_name(g_stable_name,g_stable_name_len,&s,1);r->old_grade=r->new_grade=s.grade;r->old_frontier=s.frontier;r->new_frontier=s.frontier;if(cleared)r->cleared=*cleared;r->tuple_valid=progression_dungeon_tuple_valid(cleared)?1u:0u;if(!allow||!r->tuple_valid){g_progression_profile_dungeon_grade=s.grade;return 1;}canonical=*cleared;mapped=(unsigned)dungeon_progression_dungeon_grade_shipped_floor(cleared,&canonical,&target);harder=!s.frontier_valid||progression_dungeon_tuple_compare(&canonical,&s.frontier)>0;n=s;if(harder){n.frontier_valid=1u;n.frontier=canonical;r->frontier_advanced=1u;changed=1u;}if(mapped){if(n.grade<target){n.grade=target;changed=1u;}}r->grade_up=n.grade>s.grade?1u:0u;r->new_grade=n.grade;r->new_frontier=n.frontier;if(!changed){g_progression_profile_dungeon_grade=s.grade;return 1;}if(!progression_dungeon_grade_save_name(g_stable_name,g_stable_name_len,&n)){r->frontier_advanced=0u;r->grade_up=0u;r->new_grade=s.grade;r->new_frontier=s.frontier;g_progression_profile_dungeon_grade=s.grade;return 0;}r->saved=1u;g_progression_profile_dungeon_grade=n.grade;return 1;}
#endif
