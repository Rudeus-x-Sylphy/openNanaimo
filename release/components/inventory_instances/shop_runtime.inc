static int shopping_purchase_avatar(const unsigned char*frame,int len,unsigned*added_out){
    unsigned count,i,j,oldn=g_owned_equipment_n,added=0,code,price,slot,total_price=0u;stable_u64 oldnana=g_profile_nana_cash;unsigned pending[4];
    if(len!=0x44)return 0;count=(unsigned char)frame[0x0E];if(count==0u||count>4u)return 0;
    for(i=0;i<count;i++){code=shopping_read32(frame,0x1Cu+i*4u);if(!shopping_avatar_lookup(code,&price,&slot)||!price||shopping_equip_slot_for_code(code)<0)return 0;if(shopping_find(g_owned_equipment,g_owned_equipment_n,code)>=0)return 0;for(j=0;j<i;j++)if(pending[j]==code)return 0;if(total_price>0xFFFFFFFFu-price)return 0;total_price+=price;pending[i]=code;}
    if(g_profile_nana_cash<(stable_u64)total_price)return 0;
    for(i=0;i<count;i++)if(!shopping_add_unique(g_owned_equipment,&g_owned_equipment_n,SHOPPING_MAX_OWNED_EQUIP,pending[i])){g_owned_equipment_n=oldn;return 0;}
    added=count;g_profile_nana_cash-=(stable_u64)total_price;
    if(!shopping_state_save()){g_owned_equipment_n=oldn;g_profile_nana_cash=oldnana;return 0;}if(added_out)*added_out=added;return 1;
}
static int shopping_purchase_pet(unsigned code,unsigned*price_out){unsigned price,a,b;stable_u64 oldnana;if(!shopping_pet_lookup(code,&price,&a,&b)||price==0u)return -1;if(price_out)*price_out=price;if(shopping_find(g_owned_pets,g_owned_pets_n,code)>=0||shopping_find(g_gift_pets,g_gift_pets_n,code)>=0)return -2;if(g_gift_pets_n>=SHOPPING_MAX_GIFT_PETS)return -3;if(g_profile_nana_cash<(stable_u64)price)return -4;oldnana=g_profile_nana_cash;g_profile_nana_cash-=(stable_u64)price;g_gift_pets[g_gift_pets_n++]=code;if(shopping_state_save())return 1;g_gift_pets_n--;g_profile_nana_cash=oldnana;return -5;}
static stable_u64*shop_purchase_balance(const struct shop_purchase_shop_item_row*r){if(!r)return 0;if(r->currency==SHOP_PURCHASE_CURRENCY_HANS)return &g_profile_coin_hans;if(r->currency==SHOP_PURCHASE_CURRENCY_NANA)return &g_profile_nana_cash;return 0;}
static const char*shop_purchase_currency_label(const struct shop_purchase_shop_item_row*r){return r&&r->currency==SHOP_PURCHASE_CURRENCY_HANS?"Hans":"NaNa";}
static int shopping_purchase_misc(unsigned code){const struct shop_purchase_shop_item_row*r=shop_purchase_shop_item_find(code);stable_u64*balance=shop_purchase_balance(r),oldbalance;unsigned oldn=g_owned_misc_n;if(!r||r->carrier!=2u||!r->price||!balance)return 0;if(g_owned_misc_n>=SHOPPING_MAX_MISC_ITEMS||*balance<(stable_u64)r->price)return 0;oldbalance=*balance;g_owned_misc[g_owned_misc_n++]=code;*balance-=(stable_u64)r->price;if(shopping_state_save())return 1;g_owned_misc_n=oldn;*balance=oldbalance;return 0;}
static int shop_purchase_purchase_stackable(unsigned code,unsigned qty,unsigned*price_out){const struct shop_purchase_shop_item_row*r=shop_purchase_shop_item_find(code);stable_u64*balance=shop_purchase_balance(r),oldbalance;int idx;unsigned oldn,oldcount=0u,total;if(price_out)*price_out=0u;if(!r||r->carrier!=1u||!r->price||!qty||!balance)return 0;if(qty>0xFFFFFFFFu/r->price)return 0;total=qty*r->price;if(*balance<(stable_u64)total||!inventory_instances_instances_can_add(qty))return 0;oldbalance=*balance;card_synth_items_load();oldn=g_card_synth_item_n;idx=card_synth_item_index(code);if(idx<0){if(g_card_synth_item_n>=CARD_SYNTH_ITEM_CAP)return 0;idx=(int)g_card_synth_item_n++;g_card_synth_items[idx].code=code;g_card_synth_items[idx].count=0u;}oldcount=g_card_synth_items[idx].count;if(oldcount>0xFFFFFFFFu-qty){g_card_synth_item_n=oldn;return 0;}g_card_synth_items[idx].count=oldcount+qty;*balance-=(stable_u64)total;if(!card_synth_items_save()||!inventory_instances_instances_reconcile()){g_card_synth_items[idx].count=oldcount;g_card_synth_item_n=oldn;*balance=oldbalance;card_synth_items_save();inventory_instances_instances_reconcile();return 0;}if(!shopping_state_save()){g_card_synth_items[idx].count=oldcount;g_card_synth_item_n=oldn;*balance=oldbalance;card_synth_items_save();inventory_instances_instances_reconcile();return 0;}if(price_out)*price_out=r->price;printf("  [INVENTORY_INSTANCE] purchase code=%u qty=%u currency=%s unit=%u instances=%u\n",code,qty,shop_purchase_currency_label(r),r->price,inventory_instances_instance_count(code));fflush(0);return 1;}
static int shop_purchase_pet_special_gem(unsigned action,unsigned pet_handle,unsigned slot,unsigned item_handle,unsigned*detail){unsigned special,pet,oldgem,i,remaining=0u;struct pet_crafting_pet_item_row oldrow,*row;if(detail)*detail=0u;if(action!=3u&&action!=4u)return 0;special=pet_crafting_pet_code_for_handle(item_handle);if((action==3u&&special!=18000001u)||(action==4u&&special!=18000002u))return 0;if(pet_handle>=g_owned_pets_n||slot>=3u)return 0;pet=g_owned_pets[pet_handle];pet_crafting_pet_state_load();row=pet_crafting_pet_row(pet,0);if(!row||!(oldgem=row->gems[slot]))return 0;oldrow=*row;for(i=slot;i+1u<3u;i++)row->gems[i]=row->gems[i+1u];row->gems[2]=0u;if(!pet_crafting_pet_state_save()){*row=oldrow;return 0;}if(!inventory_instances_instance_exchange(special,item_handle,action==3u?oldgem:0u,&remaining)){*row=oldrow;pet_crafting_pet_state_save();return 0;}printf("  [PET_INSTANCE_ORDER] action=%u pet=%u handle=%u removed_slot=%u oldgem=%u compacted=%u/%u/%u special=%u identity=%u remaining=%u returned=%u\n",action,pet,pet_handle,slot,oldgem,row->gems[0],row->gems[1],row->gems[2],special,item_handle,remaining,action==3u?oldgem:0u);fflush(0);return 1;}
static int shop_purchase_pet_handle_c44f(SOCKET c,const unsigned char*f,int len){unsigned action,pet_handle,slot,item_handle,detail=0u;int ok=0;if(len!=24)return 0;action=(unsigned)f[8]|((unsigned)f[9]<<8);if(action==1u||action==2u)return pet_crafting_pet_handle_c44f(c,f,len);pet_handle=(unsigned char)f[0x0A];slot=(unsigned char)f[0x0B];item_handle=(unsigned char)f[0x0C];ok=shop_purchase_pet_special_gem(action,pet_handle,slot,item_handle,&detail);printf("  [SHOP_PURCHASE_SPECIAL] C44F action=%u pet_handle=%u slot=%u item_handle=%u success=%d\n",action,pet_handle,slot,item_handle,ok);fflush(0);pet_crafting_pet_send_c450(c,ok,action,detail);return 1;}


static int shop_purchase_c430_slot(unsigned slot,unsigned*code_out,unsigned*identity_out){unsigned codes[4]={47000001u,47000002u,47000003u,47000004u},qty[4],i,row=0u;card_key_item_state_load();card_synth_items_load();quickbar_handles_load();if(!inventory_instances_instances_reconcile())return 0;for(i=0u;i<4u;i++)qty[i]=card_key_item_quantity(codes[i]);for(i=0u;i<4u;i++)if(qty[i]&&quickbar_item_handle(codes[i])){if(row++==slot){if(code_out)*code_out=codes[i];if(identity_out)*identity_out=quickbar_item_handle(codes[i]);return 1;}}for(i=1u;i<256u;i++)if(g_quickbar_handles[i]){unsigned code=g_quickbar_handles[i];int q=card_synth_item_index(code);if(q<0||!g_card_synth_items[q].count)continue;if(row++==slot){if(code_out)*code_out=code;if(identity_out)*identity_out=i;return 1;}}return 0;}
static int shop_purchase_face_allowed(unsigned coupon,unsigned face){switch(coupon){case 45000001u:return face>=10100004u&&face<=10100008u;case 45000002u:return face>=10100009u&&face<=10100013u;case 45000003u:return face>=10100022u&&face<=10100026u;case 45000004u:return face>=10100027u&&face<=10100031u;default:return 0;}}
static int shop_purchase_use_face_coupon(const unsigned requested[9],unsigned slot,unsigned*coupon_out,unsigned*identity_out,unsigned*remaining_out){struct card_synth_item_row oldrows[CARD_SYNTH_ITEM_CAP];unsigned current[9],oldh[256],oldc[QUICKBAR_SLOT_COUNT],oldi[QUICKBAR_SLOT_COUNT],oldn,oldowned,oldface,coupon=0u,identity=0u,remaining=0u,i;if(coupon_out)*coupon_out=0u;if(identity_out)*identity_out=0u;if(remaining_out)*remaining_out=0u;shopping_fill_appearance(current);for(i=0u;i<9u;i++)if(i!=1u&&requested[i]!=current[i])return 0;if(!shop_purchase_c430_slot(slot,&coupon,&identity)||coupon/1000000u!=45u||!shop_purchase_face_allowed(coupon,requested[1]))return 0;if(shopping_equip_slot_for_code(requested[1])!=1)return 0;card_synth_items_load();quickbar_handles_load();quickbar_load();oldn=g_card_synth_item_n;oldowned=g_owned_equipment_n;oldface=g_stable_equip[1];memcpy(oldrows,g_card_synth_items,sizeof(oldrows));memcpy(oldh,g_quickbar_handles,sizeof(oldh));memcpy(oldc,g_quickbar_code,sizeof(oldc));memcpy(oldi,g_quickbar_instance,sizeof(oldi));if(!shopping_add_unique(g_owned_equipment,&g_owned_equipment_n,SHOPPING_MAX_OWNED_EQUIP,requested[1]))return 0;if(!inventory_instances_instance_exchange(coupon,identity,0u,&remaining)){g_owned_equipment_n=oldowned;return 0;}g_stable_equip[1]=requested[1];shopping_sync_legacy_equipped();if(shopping_state_save()){if(coupon_out)*coupon_out=coupon;if(identity_out)*identity_out=identity;if(remaining_out)*remaining_out=remaining;return 1;}g_stable_equip[1]=oldface;g_owned_equipment_n=oldowned;shopping_sync_legacy_equipped();memcpy(g_card_synth_items,oldrows,sizeof(oldrows));g_card_synth_item_n=oldn;memcpy(g_quickbar_handles,oldh,sizeof(oldh));memcpy(g_quickbar_code,oldc,sizeof(oldc));memcpy(g_quickbar_instance,oldi,sizeof(oldi));card_synth_items_save();quickbar_handles_save();quickbar_save();shopping_state_save();return 0;}

static unsigned shop_catalogs_cash_bundle_units(unsigned code){switch(code){case 42000001u:return 5u;case 42000002u:return 5u;case 42000003u:return 11u;case 42000004u:return 11u;case 42000005u:return 1u;case 42000006u:return 32u;case 42000007u:return 99u;case 42000008u:return 11u;case 48000001u:return 5u;case 48000002u:return 10u;case 48000003u:return 30u;case 48000004u:return 1u;case 48000005u:return 5u;case 48000006u:return 11u;case 48000007u:return 32u;default:return 1u;}}
static int shop_catalogs_claim_cash_to_gameitem(unsigned code,unsigned*units_out){int mi,ci;unsigned i,old_misc_n,old_item_n,old_count=0u,units=shop_catalogs_cash_bundle_units(code);if(units_out)*units_out=0u;mi=shopping_find(g_owned_misc,g_owned_misc_n,code);if(mi<0||!shop_purchase_shop_item_find(code)||!inventory_instances_instances_can_add(1u))return 0;card_synth_items_load();old_misc_n=g_owned_misc_n;old_item_n=g_card_synth_item_n;ci=card_synth_item_index(code);if(ci<0){if(g_card_synth_item_n>=CARD_SYNTH_ITEM_CAP)return 0;ci=(int)g_card_synth_item_n++;g_card_synth_items[ci].code=code;g_card_synth_items[ci].count=0u;}old_count=g_card_synth_items[ci].count;if(old_count==0xFFFFFFFFu){g_card_synth_item_n=old_item_n;return 0;}g_card_synth_items[ci].count=old_count+1u;shopping_remove_at(g_owned_misc,&g_owned_misc_n,(unsigned)mi);if(!card_synth_items_save()||!inventory_instances_instances_reconcile()){g_card_synth_items[ci].count=old_count;g_card_synth_item_n=old_item_n;card_synth_items_save();inventory_instances_instances_reconcile();for(i=g_owned_misc_n;i>(unsigned)mi;i--)g_owned_misc[i]=g_owned_misc[i-1];g_owned_misc[mi]=code;g_owned_misc_n=old_misc_n;return 0;}if(!shopping_state_save()){g_card_synth_items[ci].count=old_count;g_card_synth_item_n=old_item_n;card_synth_items_save();inventory_instances_instances_reconcile();for(i=g_owned_misc_n;i>(unsigned)mi;i--)g_owned_misc[i]=g_owned_misc[i-1];g_owned_misc[mi]=code;g_owned_misc_n=old_misc_n;return 0;}if(units_out)*units_out=units;return 1;}
/* SHOP_CATALOGS stored MI native-use counts as ledger rows. C430 WORD+4 is only a
   row identity, while C46E success deletes one row and the original client
   adds the MI definition's native use count. Migrate old inflated counts once
   per account to bundle counts; all INVENTORY_MIGRATION allocations add one bundle. */
static void inventory_migration_cash_migration_path(char*out,const char*suffix){char a[32];unsigned n=0u,i=0u;const char*p="adapter_cash_bundle_migration_";card_safe_account(a);while(*p)out[n++]=*p++;while(a[i])out[n++]=a[i++];while(*suffix)out[n++]=*suffix++;out[n]=0;}
static void inventory_migration_migrate_native_cash_units_to_bundles(void){
    char path[128],tmp[128];void*f;unsigned i,changed=0u;struct card_synth_item_row backup[CARD_SYNTH_ITEM_CAP];unsigned oldn;
    inventory_migration_cash_migration_path(path,".dat");f=fopen(path,"r");if(f){fclose(f);return;}
    card_synth_items_load();oldn=g_card_synth_item_n;memcpy(backup,g_card_synth_items,sizeof(backup));
    for(i=0u;i<g_card_synth_item_n;i++){unsigned code=g_card_synth_items[i].code,domain=code/1000000u,units=shop_catalogs_cash_bundle_units(code),old=g_card_synth_items[i].count;if((domain==42u||domain==48u)&&units>1u&&old>=units&&old%units==0u){g_card_synth_items[i].count=old/units;changed++;printf("  [CASH_MIGRATE] code=%u old_units=%u units_per_bundle=%u bundles=%u\n",code,old,units,g_card_synth_items[i].count);}}
    if(changed&&!card_synth_items_save()){g_card_synth_item_n=oldn;memcpy(g_card_synth_items,backup,sizeof(backup));printf("  [CASH_MIGRATE] save failed; marker withheld\n");fflush(0);return;}
    inventory_migration_cash_migration_path(tmp,".new");f=fopen(tmp,"w");if(!f)return;fprintf(f,"version=1\nconverted=%u\n",changed);if(fclose(f)!=0)return;remove(path);if(rename(tmp,path)!=0){remove(tmp);return;}printf("  [CASH_MIGRATE] committed converted=%u marker=%s\n",changed,path);fflush(0);
}

