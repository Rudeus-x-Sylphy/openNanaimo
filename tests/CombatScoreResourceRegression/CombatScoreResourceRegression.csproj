<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Nanaimo.Adapter</AssemblyName>
    <ScoreCatalogPath Condition="'$(ScoreCatalogPath)' == ''">../../adapter_runtime/资源/数据/dungeon_combat_catalog.bin</ScoreCatalogPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../managed/Nanaimo.Gameplay.csproj" />
    <Content Include="$(ScoreCatalogPath)" Link="资源/数据/dungeon_combat_catalog.bin" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
