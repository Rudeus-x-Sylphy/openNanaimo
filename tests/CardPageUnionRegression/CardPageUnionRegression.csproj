    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.16"/><Content Include="../../adapter_runtime/资源/数据/**/*" Link="资源/数据/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
