<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Reuse the production internal-test friend without touching the host runner. -->
    <AssemblyName>Nanaimo.Adapter</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../adapter_runtime/资源/数据/**/*" Link="资源/数据/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../managed/Nanaimo.Gameplay.csproj" />
  </ItemGroup>
</Project>
