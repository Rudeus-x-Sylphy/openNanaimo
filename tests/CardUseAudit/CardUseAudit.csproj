<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nanaimo.Adapter</AssemblyName>
    <AuditRuntimeRoot Condition="'$(AuditRuntimeRoot)' == ''">../../adapter_runtime</AuditRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Nanaimo.Gameplay"><HintPath>$(AuditRuntimeRoot)/Nanaimo.Gameplay.dll</HintPath></Reference>
    <Content Include="$(AuditRuntimeRoot)/资源/数据/**/*" Link="资源/数据/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
